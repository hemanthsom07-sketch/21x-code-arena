# Copy to supabase/functions/.env (git-ignored), then:  supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically: do not add them.
JUDGE_ENGINE=piston
PISTON_URL=https://your-tunnel-or-server.example.com
PISTON_TOKEN=same-value-as-JUDGE_TOKEN
# Optional
# JUDGE_CONCURRENCY=4
# PISTON_LANG_C=c
# PISTON_LANG_PYTHON=python
# PISTON_MAX_RUN_TIMEOUT_MS=10000   # must equal PISTON_RUN_TIMEOUT in infra/piston/docker-compose.yml

# Production hardening / tuning (all optional)
# ALLOWED_ORIGINS=https://your-site.example.com        # comma-separated; unset = any origin (fine for development only)
# LEADERBOARD_CACHE_SECONDS=10

